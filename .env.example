# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 커밋하지 않는다.
# 값 발급은 작업계획서(docs/WORKPLAN.md)의 U1 단계에서 사용자가 직접 수행한다.

# --- Supabase (https://supabase.com/dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 클라이언트 코드에서 참조하지 않는다(RLS를 우회하는 키).
SUPABASE_SERVICE_ROLE_KEY=

# --- 카카오 책 검색 (https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키) ---
# 서버 전용. Route Handler에서만 사용한다.
KAKAO_REST_API_KEY=

# --- 앱 ---
# 매직링크 리다이렉트 기준 주소. 배포 시 실제 도메인으로 교체.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
