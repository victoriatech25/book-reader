# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 커밋하지 않는다.
# 값 발급은 작업계획서(docs/WORKPLAN.md)의 U1 단계에서 사용자가 직접 수행한다.

# --- Supabase ---
# Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Settings → API Keys → Publishable key (sb_publishable_...)
# 브라우저에 노출되는 것이 정상이다. 권한 제한은 RLS 정책이 담당한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings → API Keys → Secret keys (sb_secret_...)
# 서버 전용. RLS를 우회하는 관리자 키이므로 절대 클라이언트 코드에서 참조하지 않는다.
# 사용처는 세 곳뿐: 마이그레이션·시드 스크립트, RLS 테스트, E2E 세션 주입.
SUPABASE_SERVICE_ROLE_KEY=
# 참고: Settings → JWT Keys 의 구형 anon/service_role JWT 키는 사용하지 않는다.

# --- 카카오 책 검색 (https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키) ---
# 서버 전용. Route Handler에서만 사용한다.
KAKAO_REST_API_KEY=

# --- 앱 ---
# 매직링크 리다이렉트 기준 주소. 배포 시 실제 도메인으로 교체.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
